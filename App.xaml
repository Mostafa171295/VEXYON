<Application x:Class="VEXYON.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- ===== Palette: VEXYON (deep space + violet glow + silver) ===== -->
    <SolidColorBrush x:Key="Blue" Color="#8B6BFF"/>
    <SolidColorBrush x:Key="Surface" Color="#0E0E26"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#16163A"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#07071A"/>
    <SolidColorBrush x:Key="Ok" Color="#4ADE80"/>
    <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="Err" Color="#F87171"/>
    <SolidColorBrush x:Key="Disabled" Color="#3A3A66"/>
    <SolidColorBrush x:Key="ReadOnlyBg" Color="#0A0A1D"/>
    <SolidColorBrush x:Key="Track" Color="#1B1B3D"/>
    <SolidColorBrush x:Key="DeepBlue" Color="#4A2BD9"/>
    <SolidColorBrush x:Key="Ink" Color="#ECECF8"/>
    <SolidColorBrush x:Key="SubInk" Color="#9A9CC8"/>
    <SolidColorBrush x:Key="SoftBlue" Color="#1A1840"/>
    <SolidColorBrush x:Key="Line" Color="#2E2B66"/>

    <LinearGradientBrush x:Key="BlueGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#A58BFF" Offset="0"/>
      <GradientStop Color="#6D4BFF" Offset="0.55"/>
      <GradientStop Color="#4A2BD9" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WinBg" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#0B0A24" Offset="0"/>
      <GradientStop Color="#05050F" Offset="0.55"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlowLine" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#006D4BFF" Offset="0"/>
      <GradientStop Color="#8B6BFF" Offset="0.5"/>
      <GradientStop Color="#006D4BFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TitleGrad" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#F4F4FF" Offset="0"/>
      <GradientStop Color="#B9B2FF" Offset="0.6"/>
      <GradientStop Color="#8B6BFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Glow effects ===== -->
    <DropShadowEffect x:Key="GlowSoft" Color="#7C5CFF" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
    <DropShadowEffect x:Key="GlowStrong" Color="#7C5CFF" BlurRadius="26" ShadowDepth="0" Opacity="1"/>
    <DropShadowEffect x:Key="GlowText" Color="#8B6BFF" BlurRadius="14" ShadowDepth="0" Opacity="0.65"/>

    <!-- ===== Primary button (glowing violet) ===== -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Margin="3">
              <Border x:Name="Glow" CornerRadius="10" Background="{DynamicResource Blue}"
                      Opacity="0.35" Effect="{DynamicResource GlowSoft}"/>
              <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource BlueGrad}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Opacity" Value="0.95"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Disabled}"/>
                <Setter TargetName="Glow" Property="Opacity" Value="0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Ghost button (white with blue outline) ===== -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Margin="3">
              <Border x:Name="Glow" CornerRadius="10" Background="{DynamicResource Blue}"
                      Opacity="0" Effect="{DynamicResource GlowSoft}"/>
              <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource Surface}"
                      BorderBrush="{DynamicResource Blue}" BorderThickness="1.5"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Glow" Property="Opacity" Value="0.45"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Disabled}"/>
                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                <Setter TargetName="Glow" Property="Opacity" Value="0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Input box (glows on focus) ===== -->
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Blue}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Blue}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid Margin="2">
              <Border x:Name="Glow" CornerRadius="10" Background="{DynamicResource Blue}"
                      Opacity="0" Effect="{DynamicResource GlowSoft}"/>
              <Border x:Name="Bd" CornerRadius="10" Background="{DynamicResource Surface}"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1.5">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Glow" Property="Opacity" Value="0.55"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ReadOnlyBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Tabs with glowing underline ===== -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Visibility="Collapsed">
                <TabPanel IsItemsHost="True" Background="Transparent"/>
              </Border>
              <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                      BorderThickness="1" CornerRadius="14" Padding="6">
                <ContentPresenter ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Margin="2,0">
              <Border x:Name="Bd" Padding="20,10" CornerRadius="10,10,0,0" Background="Transparent">
                <ContentPresenter x:Name="Cp" ContentSource="Header"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource SubInk}"
                                  TextElement.FontWeight="SemiBold"/>
              </Border>
              <Border x:Name="Bar" Height="3" VerticalAlignment="Bottom" Margin="10,0"
                      CornerRadius="2" Background="{DynamicResource Blue}" Opacity="0"
                      Effect="{DynamicResource GlowStrong}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SoftBlue}"/>
                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Progress bar with glowing fill ===== -->
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource Track}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="6" Background="{TemplateBinding Background}"/>
              <Border x:Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left"
                      Background="{DynamicResource BlueGrad}" Effect="{DynamicResource GlowSoft}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== Card ===== -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- ===== CheckBox (themed, readable in both modes) ===== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center"
                      Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Blue}" BorderThickness="1.5">
                <Path x:Name="Tick" Data="M4,10 L8,14 L16,5" Stroke="White" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,8,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BlueGrad}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Effect" Value="{DynamicResource GlowSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
