            <TextBlock Text="© 2026 Eng Moustafa Khalaf  ·  جميع الحقوق محفوظة" HorizontalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource SubInk}" Margin="0,4,0,10"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    </Grid>

    <!-- ===== Status bar ===== -->
    <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" Padding="16,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource Warn}" Margin="0,0,6,0"/>
          <TextBlock x:Name="StatusOllama" Text="Ollama..." FontSize="12" Foreground="{DynamicResource SubInk}"/>
        </StackPanel>
        <Border Grid.Column="1" x:Name="ModelChip" Margin="14,0,0,0" CornerRadius="8" Padding="8,2" Cursor="Hand"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="Transparent"
                ToolTip="دوس لتغيير نموذج المحادثة" MouseLeftButtonUp="ModelChip_Click">
          <TextBlock x:Name="ModelChipText" FlowDirection="LeftToRight" FontSize="12" Foreground="{DynamicResource Ink}"/>
        </Border>
        <Popup x:Name="ModelPopup" PlacementTarget="{Binding ElementName=ModelChip}" Placement="Top"
               StaysOpen="False" AllowsTransparency="True">
          <Border FlowDirection="RightToLeft" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Blue}"
                  BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="200" Margin="0,0,0,6">
            <StackPanel x:Name="ModelPopupPanel"/>
          </Border>
        </Popup>
        <TextBlock Grid.Column="2" x:Name="StatusText" Margin="14,0" FontSize="12" Foreground="{DynamicResource SubInk}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="SpeedText" Margin="0,0,14,0" FontSize="12" Foreground="{DynamicResource SubInk}" VerticalAlignment="Center"/>
          <TextBlock x:Name="FileCountText" FontSize="12" Foreground="{DynamicResource SubInk}" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Load warning (RAM / temperature) ===== -->
    <Border x:Name="LoadToast" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center"
            Margin="20,10,20,0" Padding="14,10" CornerRadius="10" MaxWidth="660"
            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Warn}" BorderThickness="1.5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Content="غيّر النموذج" Style="{StaticResource Ghost}" Click="ToastModel_Click" Margin="0,0,4,0"/>
          <Button Content="✕" Style="{StaticResource Ghost}" Click="ToastClose_Click" ToolTip="إخفاء"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Approval overlay ===== -->
    <Grid x:Name="ApproveOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="#B0000000">
      <Border Style="{StaticResource Card}" MaxWidth="580" Margin="30" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center"
              BorderBrush="{DynamicResource Warn}" BorderThickness="1.5">
        <StackPanel>
          <TextBlock Text="موافقة مطلوبة" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Warn}"/>
          <TextBlock Text="راجع التفاصيل كويس قبل ما توافق." Foreground="{DynamicResource SubInk}" Margin="0,2,0,10"/>
          <TextBox x:Name="ApproveText" Style="{StaticResource Input}" IsReadOnly="True" TextWrapping="Wrap"
                   MaxHeight="280" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Segoe UI"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ApproveYes" Content="موافق" Width="120" Click="ApproveYes_Click"/>
            <Button x:Name="ApproveNo" Content="ارفض" Width="120" Style="{StaticResource Ghost}" Click="ApproveNo_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
