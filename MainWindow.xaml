                <TextBlock TextWrapping="Wrap" LineHeight="24" Foreground="{DynamicResource Ink}"
                           Text="VEXYON مساعد ذكاء اصطناعي شخصي بيشتغل على جهازك. بيفهرس ملفاتك، بيجاوب منها بالعربي، وبيشغّل حسابات وأدوات بموافقتك."/>
                <UniformGrid Columns="2" Margin="0,12,0,0">
                  <Border Style="{StaticResource Card}" Margin="0,0,6,6" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="🔒" FontSize="20"/>
                      <TextBlock Text="خصوصية وأوفلاين" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource Ink}"/>
                      <TextBlock Text="بياناتك وملفاتك بتفضل على جهازك. الإنترنت اختياري ومقفول افتراضياً." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubInk}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="6,0,0,6" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="📚" FontSize="20"/>
                      <TextBlock Text="ذاكرة ملفاتك" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource Ink}"/>
                      <TextBlock Text="بيفهرس PDF وWord وExcel والنصوص ويجاوب منها." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubInk}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="🗣" FontSize="20"/>
                      <TextBlock Text="بيتكلم عربي" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource Ink}"/>
                      <TextBlock Text="اسأل واتكلم بالعربي من تبويب المحادثة." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubInk}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="🧮" FontSize="20"/>
                      <TextBlock Text="حسابات وأدوات" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource Ink}"/>
                      <TextBlock Text="مكتبات حسابات هندسية ورياضية، وتشغيل أدوات بعد موافقتك." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubInk}"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <!-- developer -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="المطوّر" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="الاسم" Foreground="{DynamicResource SubInk}" Margin="0,0,18,6"/>
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Eng Moustafa Khalaf" FlowDirection="LeftToRight" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="1" Text="البريد" Foreground="{DynamicResource SubInk}" Margin="0,0,18,6"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="mostafakhalaf861@gmail.com" FlowDirection="LeftToRight" Foreground="{DynamicResource Ink}"/>
                  </StackPanel>
                  <TextBlock Grid.Row="2" Text="الموبايل" Foreground="{DynamicResource SubInk}" Margin="0,0,18,0"/>
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="+201030087988" FlowDirection="LeftToRight" Foreground="{DynamicResource Ink}"/>
                  </StackPanel>
                </Grid>
                <Button Content="راسل المطوّر" HorizontalAlignment="Right" Margin="0,12,0,0" Click="MailDev_Click"/>
              </StackPanel>
            </Border>

            <!-- this computer -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="جهازك" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}" Margin="0,0,0,8"/>
                <TextBlock x:Name="AboutSys" TextWrapping="Wrap" LineHeight="24" Foreground="{DynamicResource Ink}"/>
                <TextBlock Text="المؤشر الحي في الشريط اللي فوق بيتحدّث كل ثانية ونص. مرّر الماوس على أي خانة فيه لتفاصيل أكتر."
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubInk}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <!-- legal + checks -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="الاتفاقية والفحص" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Button Content="اتفاقية الاستخدام" Style="{StaticResource Ghost}" Click="ShowEula_Click"/>
                  <Button Content="فحص مكتبة الحسابات" Style="{StaticResource Ghost}" Click="CalcTest_Click" ToolTip="بيشغّل اختبارات الدقة على مكتبة الحسابات الهندسية"/>
