<Window x:Class="VEXYON.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VEXYON - Personal AI Intelligence" Icon="icon.ico" Height="760" Width="1040" MinWidth="800" MinHeight="580"
        FlowDirection="RightToLeft" FontFamily="Segoe UI, Tahoma" FontSize="14"
        Background="{DynamicResource WinBg}" Foreground="{DynamicResource Ink}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ===== Header (thin) ===== -->
    <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" Padding="16,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="32" Height="32" Margin="0,0,10,0" CornerRadius="8" Background="#050510" ClipToBounds="True"
                ToolTip="Eng Moustafa Khalaf  ·  mostafakhalaf861@gmail.com  ·  +201030087988">
          <Image Source="mark.png" Stretch="Uniform" Margin="2"/>
        </Border>
        <TextBlock Grid.Column="1" Text="VEXYON" FontSize="19" FontWeight="SemiBold" FontFamily="Bahnschrift, Segoe UI"
                   FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Foreground="{DynamicResource TitleGrad}"/>
        <!-- live hardware indicator: CPU / RAM / GPU / CPU temperature (filled in code) -->
        <Viewbox Grid.Column="2" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0">
          <StackPanel x:Name="MetricsPanel" Orientation="Horizontal" FlowDirection="LeftToRight"/>
        </Viewbox>
        <Button Grid.Column="3" x:Name="ThemeBtn" Style="{StaticResource Ghost}" Content="☀" FontSize="16" Padding="10,2"
                Click="ThemeBtn_Click" ToolTip="تبديل بين الوضع الداكن والفاتح" VerticalAlignment="Center" Margin="6,0"/>
      </Grid>
    </Border>
    <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}" Margin="0,0,0,8"/>

    <!-- ===== Body: sidebar + pages ===== -->
    <Grid Grid.Row="2" Margin="14,0,14,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="5,0,5,0" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel x:Name="NavPanel"/>
          <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}" Margin="2,8,2,8"/>
          <Button Grid.Row="2" Content="＋ محادثة جديدة" FontWeight="Bold" Click="NewChat_Click" Margin="0,0,0,8"/>
          <TextBlock Grid.Row="3" Text="المحادثات السابقة" FontSize="12" Foreground="{DynamicResource SubInk}" Margin="4,0,4,4"/>
          <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ConvPanel"/>
          </ScrollViewer>
        </Grid>
      </Border>

    <!-- ===== Tabs ===== -->
    <TabControl x:Name="Tabs" Grid.Column="1" Margin="5,0,5,0">

      <!-- ===== Guide ===== -->
      <TabItem x:Name="TabGuide" Header="ابدأ هنا">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="أهلاً بيك! 4 خطوات وتبقى جاهز" FontSize="21" FontWeight="Bold"
                       Foreground="{DynamicResource Blue}" Effect="{DynamicResource GlowText}"/>
            <TextBlock x:Name="RamText" TextWrapping="Wrap" Foreground="{DynamicResource SubInk}" Margin="0,4,0,12"/>

            <!-- step 1 -->
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                  <Ellipse Fill="{DynamicResource BlueGrad}" Effect="{DynamicResource GlowSoft}"/>
                  <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Foreground="{DynamicResource Ink}" Text="ثبّت Ollama (المحرك اللي بيشغّل النموذج)" FontWeight="Bold"/>
                  <TextBlock Text="برنامج مجاني، بتثبته مرة واحدة زي أي برنامج عادي، وبعدها بيشتغل لوحده." TextWrapping="Wrap" Foreground="{DynamicResource SubInk}"/>
                  <TextBlock Foreground="{DynamicResource Ink}" x:Name="St1" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="تحميل Ollama" VerticalAlignment="Center" Click="OpenOllama_Click"/>
              </Grid>
            </Border>

            <!-- step 2 -->
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                  <Ellipse Fill="{DynamicResource BlueGrad}" Effect="{DynamicResource GlowSoft}"/>
                  <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Foreground="{DynamicResource Ink}" Text="نزّل النماذج (العقل نفسه)" FontWeight="Bold"/>
                  <TextBlock Text="محتاج إنترنت مرة واحدة بس (حوالي 3 لـ 5 جيجا)، وبعدها كل حاجة أوفلاين. تقدر تغيّر النموذج من الإعدادات." TextWrapping="Wrap" Foreground="{DynamicResource SubInk}"/>
                  <TextBlock Foreground="{DynamicResource Ink}" x:Name="St2" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Content="تنزيل النماذج" VerticalAlignment="Center" Click="Setup_Click"/>
              </Grid>
            </Border>

            <!-- step 3 -->
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                  <Ellipse Fill="{DynamicResource BlueGrad}" Effect="{DynamicResource GlowSoft}"/>
                  <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Foreground="{DynamicResource Ink}" Text="حط ملفاتك في الفولدر" FontWeight="Bold"/>
                  <TextBlock Text="أي PDF أو Word أو Excel أو نص أو كود تحطه في الفولدر بيتفهرس تلقائي." TextWrapping="Wrap" Foreground="{DynamicResource SubInk}"/>
                  <TextBlock Foreground="{DynamicResource Ink}" x:Name="St3" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="فتح فولدر الملفات" VerticalAlignment="Center" Click="OpenWatch_Click"/>
              </Grid>
            </Border>

            <!-- step 4 -->
            <Border Style="{StaticResource Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                  <Ellipse Fill="{DynamicResource BlueGrad}" Effect="{DynamicResource GlowSoft}"/>
                  <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Foreground="{DynamicResource Ink}" Text="اسأل واتكلم بالعربي" FontWeight="Bold"/>
                  <TextBlock Text="اسأل عن ملفاتك، أو اطلب منه يكتب كود أو ينشئ ملف. أي أمر بيغيّر حاجة بيطلب موافقتك الأول." TextWrapping="Wrap" Foreground="{DynamicResource SubInk}"/>
                  <TextBlock Foreground="{DynamicResource Ink}" x:Name="St4" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="ابدأ المحادثة" VerticalAlignment="Center" Click="StartChat_Click"/>
              </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <Button Content="تحديث الحالة" Style="{StaticResource Ghost}" Click="RefreshGuide_Click"/>
              <Button Content="أدوات مفيدة (AnythingLLM وغيره)" Style="{StaticResource Ghost}" Click="GoTools_Click"/>
            </StackPanel>

            <TextBlock Foreground="{DynamicResource Ink}" Text="جرّب تسأل (دوس على سؤال يتكتب لك):" FontWeight="SemiBold" Margin="0,10,0,4"/>
            <WrapPanel>
              <Button Content="فين ملف عقد المقاول؟" Style="{StaticResource Ghost}" Tag="فين ملف عقد المقاول؟" Click="Example_Click"/>
              <Button Content="لخّصلي ملفات الفولدر" Style="{StaticResource Ghost}" Tag="لخّصلي أهم النقاط في الملفات اللي في الفولدر" Click="Example_Click"/>
              <Button Content="اعرض الملفات" Style="{StaticResource Ghost}" Tag="اعرض الملفات اللي في فولدر المراقبة" Click="Example_Click"/>
              <Button Content="اكتب سكربت بايثون" Style="{StaticResource Ghost}" Tag="اكتب سكربت بايثون يرتّب الملفات في فولدر الشغل حسب التاريخ" Click="Example_Click"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== Chat ===== -->
      <TabItem x:Name="TabChat" Header="المحادثة">
        <Grid Margin="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatPanel"/>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Margin="0,8,0,0">
          <WrapPanel x:Name="AttachPanel" Visibility="Collapsed" Margin="0,0,0,6"/>
          <WrapPanel Margin="0,0,0,6" HorizontalAlignment="Right">
            <CheckBox x:Name="DeepToggle" Margin="12,0,0,0"
                      Content="🧠 تفكير عميق"
                      ToolTip="للأسئلة الصعبة: النموذج بيحلل قبل ما يرد (أبطأ). بيشتغل مع النماذج اللي بتدعمه زي qwen3"
                      Checked="DeepToggle_Changed" Unchecked="DeepToggle_Changed"/>
            <CheckBox x:Name="WebToggle"
                      Content="🌐 بحث الإنترنت (بيبعت سؤالك لمحرك بحث خارجي)"
                      ToolTip="مقفول افتراضياً عشان البرنامج يفضل أوفلاين وخصوصيتك محفوظة"
                      Checked="WebToggle_Changed" Unchecked="WebToggle_Changed"/>
          </WrapPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Style="{StaticResource Input}" MinHeight="48" MaxHeight="140"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     PreviewKeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"/>
            <TextBlock x:Name="InputHint" IsHitTestVisible="False" Margin="16,15,16,0" VerticalAlignment="Top"
                       Text="اكتب سؤالك...  (Enter للإرسال، Shift+Enter لسطر جديد)" Foreground="{DynamicResource SubInk}"/>
            <Button x:Name="AttachBtn" Grid.Column="1" Content="📎" FontSize="18" Width="48" Height="48" Style="{StaticResource Ghost}"
                    Margin="6,0,0,0" VerticalAlignment="Bottom" ToolTip="إرفاق ملف أو صورة" Click="Attach_Click"/>
            <Button x:Name="SendBtn" Grid.Column="2" Content="↑" FontSize="22" FontWeight="Bold" Width="48" Height="48"
                    Margin="6,0,0,0" VerticalAlignment="Bottom" ToolTip="إرسال (Enter)" Click="Send_Click"/>
          </Grid>

          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ===== Library ===== -->
      <TabItem x:Name="TabLib" Header="المكتبة">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
          <TextBlock Foreground="{DynamicResource Ink}" Text="الفولدرات والدرايفات اللي بتتفهرس (تقدر تضيف أكتر من واحد، حتى درايف كامل زي D:\):" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <Border Style="{StaticResource Card}" Margin="0,8,0,10">
            <StackPanel x:Name="FoldersPanel"/>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="➕  إضافة فولدر / درايف" Click="AddFolder_Click"/>
            <Button Content="فتح فولدر المراقبة" Style="{StaticResource Ghost}" Click="OpenWatch_Click"/>
          </StackPanel>
          <TextBlock Foreground="{DynamicResource Ink}" Text="فولدرات بيتم تخطيها (بأسمائها، مفصولة بفاصلة) - عشان الفهرسة تفضل سريعة ونضيفة:" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBox x:Name="SkipBox" Style="{StaticResource Input}" Margin="0,6,0,6" FlowDirection="LeftToRight"
                   TextWrapping="Wrap" MinHeight="60" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="حفظ التخطي" Style="{StaticResource Ghost}" Click="SaveSkip_Click"/>
            <Button Content="استرجاع الافتراضي" Style="{StaticResource Ghost}" Click="ResetSkip_Click"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ScanBtn" Content="فهرسة الآن" Click="Reindex_Click"/>
            <Button x:Name="StopBtn" Content="إيقاف" Style="{StaticResource Ghost}" IsEnabled="False" Click="Stop_Click"/>
          </StackPanel>
          <ProgressBar x:Name="IndexBar" Margin="0,16,0,6"/>
          <TextBlock x:Name="IndexStatus" FlowDirection="LeftToRight" HorizontalAlignment="Right" Foreground="{DynamicResource SubInk}"/>
          <Border Margin="0,16,0,0" Padding="14,10" CornerRadius="12" Background="{DynamicResource SoftBlue}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <TextBlock x:Name="StatsText" FontWeight="SemiBold" Foreground="{DynamicResource Blue}"/>
          </Border>
          <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SubInk}"
                     Text="الصيغ المدعومة: PDF, Word, Excel, نصوص وأكواد. ملفات DWG لازم تتحول الأول (شوف تبويب الأدوات: ODA File Converter). فهرسة درايف كامل أول مرة بتاخد وقت - سيبها شغالة في الخلفية، والمرات الجاية بتكون سريعة لأنها بتتخطى الملفات اللي ما اتغيرتش."/>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== Tools ===== -->
      <TabItem x:Name="TabTools" Header="الأدوات">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <TextBlock Text="أدوات تزوّد قوة البرنامج" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource Blue}" Effect="{DynamicResource GlowText}"/>
            <TextBlock Text="الإجباري الوحيد هو Ollama. الباقي اختياري، ثبّت اللي بتحتاجه بس. البرنامج بيكتشف اللي متثبت عندك."
                       TextWrapping="Wrap" Foreground="{DynamicResource SubInk}" Margin="0,4,0,10"/>
            <Button Content="إعادة فحص المثبّت" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Click="RefreshTools_Click"/>
            <StackPanel x:Name="ToolsPanel" Margin="0,6,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== Settings ===== -->
      <TabItem x:Name="TabSettings" Header="الإعدادات">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="المحرك والنماذج" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}" Margin="0,0,0,8"/>
                <Border Padding="12,8" CornerRadius="10" Background="{DynamicResource SoftBlue}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,0,8">
                  <TextBlock Foreground="{DynamicResource Ink}" x:Name="OllamaStatus" FontWeight="Bold" TextWrapping="Wrap"/>
                </Border>
                <WrapPanel Margin="0,0,0,10">
                  <Button Content="فحص Ollama" Style="{StaticResource Ghost}" Click="CheckOllama_Click"/>
                  <Button Content="تحميل Ollama (مرة واحدة)" Style="{StaticResource Ghost}" Click="OpenOllama_Click"/>
                  <Button Content="مكتبة نماذج Ollama" Style="{StaticResource Ghost}" Click="OpenLibrary_Click"/>
                </WrapPanel>

                <TextBlock Foreground="{DynamicResource Ink}" Text="نموذج المحادثة (لازم يدعم الأدوات):" FontWeight="SemiBold"/>
                <TextBox x:Name="ChatModelBox" Style="{StaticResource Input}" Margin="0,4,0,6" FlowDirection="LeftToRight"/>
                <TextBlock Foreground="{DynamicResource Ink}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="حجم ذاكرة المحادثة (توكن): 8192 للجهاز الضعيف، 16384 عادي، 32768 لو الرام 16 جيجا أو أكتر"/>
                <TextBox x:Name="NumCtxBox" Style="{StaticResource Input}" Margin="0,4,0,6" FlowDirection="LeftToRight" Width="140" HorizontalAlignment="Left"/>
                <TextBlock Text="المنزّل عندك (دوس لاختيار نموذج المحادثة):" Foreground="{DynamicResource SubInk}" FontSize="12"/>
                <WrapPanel x:Name="InstalledPanel" Margin="0,2,0,6"/>
                <TextBlock Text="اختيار سريع حسب جهازك:" Foreground="{DynamicResource SubInk}" FontSize="12"/>
                <WrapPanel Margin="0,2,0,10">
                  <Button Content="4B - كارت 4 جيجا" Style="{StaticResource Ghost}" Tag="qwen3:4b" Click="Preset_Click"/>
                  <Button Content="8B - جهاز متوسط" Style="{StaticResource Ghost}" Tag="qwen3:8b" Click="Preset_Click"/>
                  <Button Content="14B - كارت 12+ جيجا" Style="{StaticResource Ghost}" Tag="qwen3:14b" Click="Preset_Click"/>
                  <Button Content="كود 7B" Style="{StaticResource Ghost}" Tag="qwen2.5-coder:7b" Click="Preset_Click"/>
                </WrapPanel>

                <TextBlock Foreground="{DynamicResource Ink}" Text="نموذج الفهرسة (Embeddings):" FontWeight="SemiBold"/>
                <TextBox x:Name="EmbedModelBox" Style="{StaticResource Input}" Margin="0,4,0,10" FlowDirection="LeftToRight"/>

                <Button x:Name="SetupBtn" Content="تجهيز النماذج (تنزيل الناقص - محتاج نت مرة واحدة)"
                        HorizontalAlignment="Right" Click="Setup_Click"/>
                <ProgressBar x:Name="PullBar" Margin="0,10,0,6" Maximum="100"/>
                <TextBlock x:Name="PullStatus" FlowDirection="LeftToRight" HorizontalAlignment="Right"
                           TextWrapping="Wrap" Foreground="{DynamicResource SubInk}"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="تعليمات دائمة للمساعد" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}" Margin="0,0,0,8"/>
                <TextBlock Foreground="{DynamicResource SubInk}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="اكتب هنا اللي عايز المساعد يلتزم بيه في كل محادثة: أسلوب الرد، تخصصك، تفضيلاتك. بتتحفظ مع الإعدادات."/>
                <WrapPanel Margin="0,0,0,6">
                  <Button Content="رد بالعامية المصرية" Style="{StaticResource Ghost}" Tag="رد بالعامية المصرية." Click="InstPreset_Click"/>
                  <Button Content="ردود مختصرة" Style="{StaticResource Ghost}" Tag="خلّي الردود مختصرة ومباشرة." Click="InstPreset_Click"/>
                  <Button Content="شرح خطوة بخطوة" Style="{StaticResource Ghost}" Tag="اشرح خطوة بخطوة لما أطلب طريقة." Click="InstPreset_Click"/>
                  <Button Content="اذكر المصدر" Style="{StaticResource Ghost}" Tag="اذكر اسم الملف المصدر دايماً لما تجاوب من ملفاتي." Click="InstPreset_Click"/>
                </WrapPanel>
                <TextBox x:Name="InstructionsBox" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="100" MaxHeight="220" MaxLength="2000" VerticalScrollBarVisibility="Auto"
                         TextChanged="InstructionsBox_TextChanged"/>
                <TextBlock x:Name="InstructionsCount" Text="0 / 2000" FontSize="12" Foreground="{DynamicResource SubInk}"
                           HorizontalAlignment="Left" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="الذاكرة طويلة المدى" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}" Margin="0,0,0,8"/>
                <TextBlock Foreground="{DynamicResource SubInk}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="المساعد بيفتكر معلومات عنك بين المحادثات (قول له 'افتكر إني...' أو 'انسى...'). بتتخزن عندك بس على جهازك. تقدر تعدّلها أو تمسحها هنا: سطر لكل معلومة."/>
                <CheckBox x:Name="MemoryOnBox" Content="فعّل الذاكرة" Margin="0,0,0,8"/>
                <TextBox x:Name="MemoryBox" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="ذاكرة الدروس (أخطاء اتصلّحت)" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" Margin="0,12,0,4"/>
                <TextBlock Foreground="{DynamicResource SubInk}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="قواعد قصيرة بيسجّلها المساعد لما يغلط ويصلّح (أو لما تصحّحه). بتتطبّق على كل محادثة. امسح أي درس غلط من هنا: سطر لكل درس (أقصى 20)."/>
                <TextBox x:Name="LessonsBox" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="180" VerticalScrollBarVisibility="Auto"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="الأمان والتنفيذ" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}" Margin="0,0,0,8"/>
                <TextBlock Foreground="{DynamicResource Ink}" Text="فولدر الشغل (الأوامر والملفات الجديدة بتتعمل هنا بس):" FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="WorkBox" Style="{StaticResource Input}" IsReadOnly="True" FlowDirection="LeftToRight"/>
                  <Button Grid.Column="1" Content="تغيير" Style="{StaticResource Ghost}" Margin="6,0,0,0" Click="ChangeWork_Click"/>
                </Grid>
                <CheckBox x:Name="AutoApproveBox" Margin="0,14,0,0"
                          Content="نفّذ الأوامر من غير ما تسألني (مش مستحسن - الأوامر الخطيرة تفضل ممنوعة)"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="نسخ احتياطي وحزمة أوفلاين" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}" Margin="0,0,0,8"/>
                <TextBlock Foreground="{DynamicResource SubInk}" TextWrapping="Wrap"
                           Text="احفظ النماذج اللي نزّلتها (زي qwen3:8b) وملفات تثبيت البرامج وملفات البرنامج في فولدر واحد، عشان ترجّعها بعد تغيير الويندوز أو تديها لحد من غير نت. الفهرس بتاعك مش بيتنسخ."/>
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="إنشاء نسخة احتياطية" Click="Backup_Click"/>
                  <Button Content="استرجاع نسخة" Style="{StaticResource Ghost}" Click="Restore_Click"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="البيانات" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}" Margin="0,0,0,8"/>
                <TextBlock Foreground="{DynamicResource SubInk}" TextWrapping="Wrap"
                           Text="الفهرس والمحادثات وسجل الأوامر متخزنة على جهازك فقط. تبديل الوضع الداكن/الفاتح من الزرار اللي فوق."/>
                <Button Content="فتح فولدر بيانات البرنامج" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Click="OpenDataDir_Click" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Button Content="حفظ الإعدادات" Width="160" HorizontalAlignment="Right" Click="Save_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== Log ===== -->
      <TabItem x:Name="TabLog" Header="السجل">
        <TextBox x:Name="LogBox" Style="{StaticResource Input}" IsReadOnly="True" TextWrapping="Wrap"
                 FlowDirection="LeftToRight" VerticalScrollBarVisibility="Auto" Margin="6" FontFamily="Consolas"/>
      </TabItem>

      <!-- ===== About ===== -->
      <TabItem x:Name="TabAbout" Header="عن VEXYON">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">

            <!-- hero -->
            <Border Style="{StaticResource Card}" Padding="20,24">
              <StackPanel HorizontalAlignment="Center">
                <Border Width="96" Height="96" CornerRadius="22" Background="#050510" ClipToBounds="True"
                        HorizontalAlignment="Center" Effect="{DynamicResource GlowSoft}">
                  <Image Source="mark.png" Stretch="Uniform" Margin="6"/>
                </Border>
                <TextBlock Text="VEXYON" FontSize="34" FontWeight="SemiBold" FontFamily="Bahnschrift, Segoe UI"
                           FlowDirection="LeftToRight" HorizontalAlignment="Center" Margin="0,14,0,0"
                           Foreground="{DynamicResource TitleGrad}"/>
                <TextBlock Text="Think Beyond. Act Beyond." FontSize="14" FlowDirection="LeftToRight"
                           HorizontalAlignment="Center" Margin="0,2,0,12" Foreground="{DynamicResource SubInk}"/>
                <Border HorizontalAlignment="Center" CornerRadius="10" Padding="14,3" BorderThickness="1"
                        Background="{DynamicResource SoftBlue}" BorderBrush="{DynamicResource Line}">
                  <TextBlock x:Name="AboutVersion" FlowDirection="LeftToRight" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource Blue}"/>
                </Border>
              </StackPanel>
            </Border>

            <!-- what it is -->
            <Border Style="{StaticResource Card}">
              <StackPanel>
